{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArcheAge Event Schedule",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "meta": {
      "default": {
        "title": "Event Schedule",
        "eventIcons": []
      },
      "type": "object",
      "properties": {
        "title": {
          "default": "Event Schedule",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "eventIcons": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "eventIcons"
      ],
      "additionalProperties": false
    },
    "theme": {
      "default": {
        "primary": "#009688",
        "primaryContrast": "#ffffff",
        "fontFamily": "\"Flareserif821BT-Roman\", \"Helvetica\", \"Arial\", sans-serif"
      },
      "type": "object",
      "properties": {
        "primary": {
          "default": "#009688",
          "type": "string"
        },
        "primaryContrast": {
          "default": "#ffffff",
          "type": "string"
        },
        "backgroundImage": {
          "type": "string"
        },
        "fontFamily": {
          "default": "\"Flareserif821BT-Roman\", \"Helvetica\", \"Arial\", sans-serif",
          "type": "string"
        }
      },
      "required": [
        "primary",
        "primaryContrast",
        "fontFamily"
      ],
      "additionalProperties": false
    },
    "settings": {
      "default": {
        "defaultRegion": "NA",
        "defaultVolume": 70,
        "inGame": {
          "offsetHours": 2,
          "offsetMinutes": 20,
          "cycleHours": 4,
          "hourMinutes": 10
        },
        "refreshMinutes": 30
      },
      "type": "object",
      "properties": {
        "defaultRegion": {
          "default": "NA",
          "type": "string",
          "enum": [
            "NA",
            "EU",
            "SEA"
          ]
        },
        "defaultVolume": {
          "default": 70,
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "inGame": {
          "default": {
            "offsetHours": 2,
            "offsetMinutes": 20,
            "cycleHours": 4,
            "hourMinutes": 10
          },
          "type": "object",
          "properties": {
            "offsetHours": {
              "default": 2,
              "type": "number"
            },
            "offsetMinutes": {
              "default": 20,
              "type": "number"
            },
            "cycleHours": {
              "default": 4,
              "type": "number"
            },
            "hourMinutes": {
              "default": 10,
              "type": "number"
            }
          },
          "required": [
            "offsetHours",
            "offsetMinutes",
            "cycleHours",
            "hourMinutes"
          ],
          "additionalProperties": false
        },
        "refreshMinutes": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "defaultRegion",
        "defaultVolume",
        "inGame",
        "refreshMinutes"
      ],
      "additionalProperties": false
    },
    "notice": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "minLength": 1
          },
          "startMessage": {
            "type": "string"
          },
          "reminderMessage": {
            "type": "string"
          },
          "startCueId": {
            "type": "string"
          },
          "reminderCueId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "default": "event",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "disabled": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "categoryId",
          "icon",
          "disabled"
        ],
        "additionalProperties": false
      }
    },
    "timers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "enum": [
              "NA",
              "EU",
              "SEA"
            ]
          },
          "time": {
            "type": "string",
            "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$"
          },
          "duration": {
            "type": "string",
            "pattern": "^\\d{1,3}:[0-5]\\d(?::[0-5]\\d)?$"
          },
          "days": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SUNDAY",
                "MONDAY",
                "TUESDAY",
                "WEDNESDAY",
                "THURSDAY",
                "FRIDAY",
                "SATURDAY"
              ]
            }
          },
          "label": {
            "type": "string"
          },
          "inGameTime": {
            "type": "string",
            "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$"
          },
          "reminderTime": {
            "type": "string",
            "pattern": "^\\d{1,3}:[0-5]\\d(?::[0-5]\\d)?$"
          },
          "messages": {
            "default": {},
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "reminder": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "eventId",
          "time",
          "days",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "alerts": {
      "default": {
        "defaultLeadSeconds": 900,
        "options": []
      },
      "type": "object",
      "properties": {
        "defaultLeadSeconds": {
          "default": 900,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "options": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "start",
                  "reminder"
                ]
              },
              "leadSeconds": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cueId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "leadSeconds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "defaultLeadSeconds",
        "options"
      ],
      "additionalProperties": false
    },
    "cues": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "default": 0,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "label",
          "file",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "cargoShip": {
      "default": {
        "enabled": true,
        "ports": {},
        "route": [],
        "alerts": [],
        "servers": [],
        "maintenance": {}
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "defaultServerId": {
          "type": "string"
        },
        "ports": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "route": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "next": {
                "type": "string",
                "minLength": 1
              },
              "durationSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "port": {
                "type": "string"
              },
              "toPort": {
                "type": "string"
              },
              "reverse": {
                "default": false,
                "type": "boolean"
              },
              "sailing": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "text",
              "next",
              "durationSeconds",
              "reverse",
              "sailing"
            ],
            "additionalProperties": false
          }
        },
        "alerts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "stepId": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "enum": [
                  "start",
                  "end"
                ]
              },
              "offsetSeconds": {
                "default": 0,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "speech": {
                "type": "string"
              },
              "cueId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "stepId",
              "trigger",
              "offsetSeconds"
            ],
            "additionalProperties": false
          }
        },
        "servers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "enum": [
                  "NA",
                  "EU",
                  "SEA"
                ]
              },
              "linkedGroup": {
                "type": "string"
              },
              "unchained": {
                "default": false,
                "type": "boolean"
              },
              "timer": {
                "type": "object",
                "properties": {
                  "port": {
                    "type": "string",
                    "minLength": 1
                  },
                  "remainingSeconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "updatedAt": {
                    "type": "string"
                  },
                  "noLinkedUpdate": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "port",
                  "remainingSeconds",
                  "updatedAt",
                  "noLinkedUpdate"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "name",
              "region",
              "unchained"
            ],
            "additionalProperties": false
          }
        },
        "maintenance": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "NA",
              "EU",
              "SEA"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "enum": [
                  "SUNDAY",
                  "MONDAY",
                  "TUESDAY",
                  "WEDNESDAY",
                  "THURSDAY",
                  "FRIDAY",
                  "SATURDAY"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$"
              }
            },
            "required": [
              "day"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "ports",
        "route",
        "alerts",
        "servers",
        "maintenance"
      ],
      "additionalProperties": false
    },
    "sponsors": {
      "default": {
        "title": "Sponsor",
        "icon": "torch",
        "color": "#6a1b9a",
        "streams": []
      },
      "type": "object",
      "properties": {
        "title": {
          "default": "Sponsor",
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "default": "torch",
          "type": "string",
          "minLength": 1
        },
        "color": {
          "default": "#6a1b9a",
          "type": "string",
          "minLength": 1
        },
        "streams": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "enum": [
                  "youtube",
                  "twitch"
                ]
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "videoId": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "provider",
              "channel"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "icon",
        "color",
        "streams"
      ],
      "additionalProperties": false
    },
    "pronunciations": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "meta",
    "theme",
    "settings",
    "categories",
    "events",
    "timers",
    "alerts",
    "cues",
    "cargoShip",
    "sponsors",
    "pronunciations"
  ],
  "additionalProperties": false
}
