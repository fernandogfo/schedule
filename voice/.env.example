# voice/.env.example — copy this file to voice/.env and adjust values

# Port the FastAPI server listens on
HOST=0.0.0.0
PORT=8000

# Path to the speaker reference audio (mp3, wav, flac, ogg)
# If omitted, auto-detects reference.mp3 or reference.wav in the speaker/ directory
SPEAKER_FILE=speaker/reference.mp3

# Language for TTS (en = English, pt = Portuguese, etc.)
LANGUAGE=en

# Directory where generated audio files are cached
CACHE_DIR=cache

# Set to 1 to force CPU even when a GPU is available
FORCE_CPU=0
